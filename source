======
RULES
======

(moving stuff with player)
[ > Player Player1 movetag solid] -> [ > Player > Player1 > Movetag > solid] 
[ > Player1 toggletag] -> [ > Player1 > toggletag] 
[ > Player Player1 solid | solid] -> cancel sfx1

(player did action)
[action Player][]->[action Player][actionflag]
[moving Player][] -> [moving Player][actionflag]

(action on movetag)
[action Player Movetag no Player1] -> [ Player Movetag Player1]
[action Player Movetag Player1 noBlocks] -> sfx1
[action Player Movetag Player1 no noBlocks] -> [action Player Movetag]

(action on toggletag)
[action Player toggletag MirrorF] -> [Player toggletag MirrorB]
[action Player toggletag MirrorB] -> [action Player toggletag MirrorF]

( source )
[stationary Player][T0 Source]->[stationary Player][T0 Source Blip newBlip]
[newBlip _Red] -> 		[newBlip Red _Red]
[newBlip _Yellow] -> 	[newBlip Yellow _Yellow]
[newBlip _Green] -> 	[newBlip Green _Green]
[newBlip _Blue] -> 		[newBlip Blue _Blue]
[newBlip _Cyan] -> 		[newBlip Cyan _Cyan]
[newBlip _Magenta] -> 	[newBlip Magenta _Magenta]
[newBlip _R] -> 		[newBlip moveR _R]
[newBlip _D] -> 		[newBlip moveD _D]
[newBlip _L] -> 		[newBlip moveL _L]
[newBlip _U] -> 		[newBlip moveU _U]
late [_color no Source no Target] -> []
late [newBlip] -> []

(movement cancellation)
late [moveR moveL] -> [ ]
late [moveU moveD] -> [ ]

(move blip)
right [stationary Player no actionflag][stationary Blip moveR no againflag]->[stationary Player][Marker > Blip > moveR]
left  [stationary Player no actionflag][stationary Blip moveL no againflag]->[stationary Player][Marker > Blip > moveL]
up    [stationary Player no actionflag][stationary Blip moveU againflag no Reflected]->[stationary Player][Marker > Blip > moveU againflag]
down  [stationary Player no actionflag][stationary Blip moveD againflag no Reflected]->[stationary Player][Marker > Blip > moveD againflag]

(move blip flags)
[stationary Player no actionflag][> Blip | Marker] -> [stationary Player][> Blip |] 
[stationary Player no actionflag][> Blip stationary dir]->[stationary Player][> Blip > dir]
[stationary Player no actionflag][> Blip stationary primary]->[stationary Player][> Blip > primary]

(go again every other update)
[stationary Player no actionflag][] -> [stationary Player][againflag]
[stationary Player no actionflag][againflag againflag1] -> [stationary Player][]
[stationary Player no actionflag][againflag]->[stationary Player][againflag againflag1] again

(delete lonely blips and flags)
late [no againflag][Blip Dir Opaque no Player1] -> [][opaque]
late [Marker Blip Dir] -> [] 
late [Marker Blip] -> [] 
late [dir no Blip] -> []
late [color no Blip no againflag] -> []
late [topcolor no Blip no againflag] -> []
late [Marker no Blip] -> []
late [Blip no dir] -> []


(reflections)
late [Blip moveD reflectne no Reflected no Player1 no actionflag no againflag] -> [Blip moveR reflectne Reflected]
late [Blip moveL reflectne no Reflected no Player1 no actionflag no againflag] -> [Blip moveU reflectne Reflected]
late [Blip moveR reflectnw no Reflected no Player1 no actionflag no againflag] -> [Blip moveU reflectnw Reflected]
late [Blip moveD reflectnw no Reflected no Player1 no actionflag no againflag] -> [Blip moveL reflectnw Reflected]
late [Blip moveU reflectsw no Reflected no Player1 no actionflag no againflag] -> [Blip moveL reflectsw Reflected]
late [Blip moveR reflectsw no Reflected no Player1 no actionflag no againflag] -> [Blip moveD reflectsw Reflected]
late [Blip moveL reflectse no Reflected no Player1 no actionflag no againflag] -> [Blip moveD reflectse Reflected]
late [Blip moveU reflectse no Reflected no Player1 no actionflag no againflag] -> [Blip moveR reflectse Reflected]
late [MirrorToggle MirrorF Reflected no Player1 no actionflag no againflag] -> [MirrorToggle MirrorB]
late [MirrorToggle MirrorB Reflected no Player1 no actionflag no againflag] -> [MirrorToggle MirrorF]
late [no againflag Reflected]->[]

(secondary colors)
late [red Blue][no againflag] -> [ red Blue Magenta][]
late [red Green][no againflag] -> [ red Green Yellow][]
late [Green Blue][no againflag] -> [ Green Blue Cyan][]
late [red no green no Blue][no againflag] -> [red TopRed][]
late [no red green no Blue][no againflag] -> [green TopGreen][]
late [no red no green Blue][no againflag] -> [blue TopBlue][]

(drawBlip)
late [drawBlip no Blip] -> []
late [Blip no againflag] -> [Blip drawBlip]

(clock)
[stationary Player no againflag no actionflag][T3]->[stationary Player][T4]
[stationary Player no againflag no actionflag][T2]->[stationary Player][T3]
[stationary Player no againflag no actionflag][T1]->[stationary Player][T2]
[stationary Player no againflag no actionflag][T0]->[stationary Player][T1]
[stationary Player no againflag no actionflag][T4]->[stationary Player][T0]

(Target Satisfaction)
late [no againflag no actionflag][Target] -> [][Target Happy]
late [no againflag no actionflag][Target _Red no Red] -> [][Target _Red no Happy]
late [no againflag no actionflag][Target _Green no Green] -> [][Target _Green no Happy]
late [no againflag no actionflag][Target _Blue no Blue] -> [][Target _Blue no Happy]
late [no againflag no actionflag][Target Happy] -> [][Target Happy T0]
